local function CreateESP(player)
	if ESPObjects[player] then return end

	local esp = {}

	local nameBillboard = Instance.new("BillboardGui")
	nameBillboard.Name = "ESP_Name"
	nameBillboard.AlwaysOnTop = true
	nameBillboard.Size = UDim2.new(0, 200, 0, 50)
	nameBillboard.StudsOffset = Vector3.new(0, 3, 0)
	nameBillboard.Adornee = player.Character and player.Character:FindFirstChild("Head")
	nameBillboard.Parent = player.Character

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Parent = nameBillboard
	nameLabel.Size = UDim2.new(1, 0, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = player.Name
	nameLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
	nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 16

	local box = Instance.new("BoxHandleAdornment")
	box.Name = "ESP_Box"
	box.AlwaysOnTop = true
	box.ZIndex = 10
	box.Size = Vector3.new(4, 6, 4)
	box.Adornee = player.Character
	box.Color3 = Color3.fromRGB(255, 0, 0)
	box.Transparency = 0.3
	box.Parent = player.Character

	esp.Name = nameBillboard
	esp.Box = box
	ESPObjects[player] = esp
end

local function RemoveESP(player)
	if ESPObjects[player] then
		if ESPObjects[player].Name then
			ESPObjects[player].Name:Destroy()
		end
		if ESPObjects[player].Box then
			ESPObjects[player].Box:Destroy()
		end
		ESPObjects[player] = nil
	end
end

