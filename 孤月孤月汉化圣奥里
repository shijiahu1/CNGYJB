---------------------------------
--  优化后的翻译核心
---------------------------------
local function translateText(text)
    if type(text) ~= "string" then return text end
    return Translations[text] or text   -- 仅精确匹配，高效且无误
end

local function translateControl(control)
    if not control or not control.IsA then return end
    if control:IsA("TextLabel") or control:IsA("TextButton") or control:IsA("TextBox") then
        local original = control.Text
        if original and original ~= "" then
            local translated = translateText(original)
            if translated ~= original then
                pcall(function()
                    control.Text = translated
                end)
            end
        end
    end
end

local function setupTranslationEngine()
    local scanned = {}   -- 用弱表避免内存泄漏，但 Instance 无法弱引用？可忽略

    -- 递归扫描并翻译
    local function scanDescendants(parent)
        for _, child in ipairs(parent:GetDescendants()) do
            if not scanned[child] then
                translateControl(child)
                scanned[child] = true
            end
        end
    end

    -- 监听新增子对象
    local function watchForNewChildren(parent)
        parent.DescendantAdded:Connect(function(desc)
            -- 延迟一帧确保属性已设置
            task.wait(0.1)
            if not scanned[desc] then
                translateControl(desc)
                scanned[desc] = true
            end
        end)
    end

    -- 主要 GUI 容器
    local coreGui = game:GetService("CoreGui")
    local player = game:GetService("Players").LocalPlayer
    local playerGui = player and player:FindFirstChild("PlayerGui")

    -- 初始扫描并监听
    if coreGui then
        scanDescendants(coreGui)
        watchForNewChildren(coreGui)
    end

    if playerGui then
        scanDescendants(playerGui)
        watchForNewChildren(playerGui)
    end

    -- 额外：当 PlayerGui 稍后加载时，也可监听 Player 的 ChildAdded
    if player then
        player.ChildAdded:Connect(function(child)
          watchForNewChildren(child)
            end
        end)
    end

    -- 可选：对部分动态生成的 ScreenGui 做额外处理（如 VxSans 自己的 GUI）
    -- 可扩展为监听 CoreGui 下新 ScreenGui
end

