local function sendNotification(title, message, duration)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title or CONFIG.GUI_TITLE,
        Text = message,
        Duration = duration or 3
    })
end

local function copyToClipboard(text)
    setclipboard(text)
    sendNotification("复制成功", text, 2)
end

local function saveData(fileName, data)
    local success, result = pcall(function()
        local jsonData = HttpService:JSONEncode(data)
        writefile(fileName, jsonData)
        return true
    end)
    return success
end

local function loadData(fileName)
    if not isfile(fileName) then return nil end
    local success, result = pcall(function()
        local jsonData = readfile(fileName)
        return HttpService:JSONDecode(jsonData)
    end)
    if success then
        return result
    end
    return nil
end

local function isWhitelisted(name)
    if CONFIG.WHITELIST_NAMES[name] then
        return true
    end
    local whitelistData = loadData(CONFIG.WHITELIST_FILE)
    if whitelistData and whitelistData[name] then
        return true
    end
    return false
end

local function addToWhitelist(name)
    local whitelistData = loadData(CONFIG.WHITELIST_FILE) or {}
    whitelistData[name] = {
        added = os.time(),
        expires = os.time() + CONFIG.KEY_DURATION * 7
    }
    return saveData(CONFIG.WHITELIST_FILE, whitelistData)
end

local KeySystem = {
    _keyData = nil,
}

function KeySystem:saveKey(key)
    local keyData = {
        key = key,
        timestamp = os.time(),
        expires = os.time() + CONFIG.KEY_DURATION,
        gameId = game.PlaceId,
        playerName = playerName
    }
    if saveData(CONFIG.KEY_FILE, keyData) then
        self._keyData = keyData
        local expirationDate = os.date("%m/%d/%Y at %I:%M %p", keyData.expires)
        sendNotification("卡密已保存", "到期时间：" .. expirationDate)
        return true
    end
    return false
end

function KeySystem:loadSavedKey()
    local keyData = loadData(CONFIG.KEY_FILE)
    if not keyData then return nil end
    local currentTime = os.time()
    if currentTime >= keyData.expires then
        delfile(CONFIG.KEY_FILE)
        return nil
    end
    if keyData.gameId ~= game.PlaceId then
        sendNotification("卡密错误", "卡密来自不同的游戏\n请重新获取", 5)
        delfile(CONFIG.KEY_FILE)
        return nil
    end
    if keyData.playerName ~= playerName then
        sendNotification("卡密错误", "此卡密已被其他玩家使用", 5)
        delfile(CONFIG.KEY_FILE)
        return nil
    end
    self._keyData = keyData
    return keyData.key
end

function KeySystem:verifyKey(key)
    return key == CONFIG.VALID_KEY
end

local ScriptLoader = {
    _isLoading = false,
